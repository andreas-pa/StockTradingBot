# Copy this file to .env and fill in your values.

# Alpaca PAPER trading keys.
# Find them at https://app.alpaca.markets under Paper Trading > API Keys.
APCA_API_KEY_ID=your_paper_key_id
APCA_API_SECRET_KEY=your_paper_secret_key

# Telegram bot token. Create a bot by messaging @BotFather in Telegram and sending /newbot.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Your Telegram chat id. Message @userinfobot in Telegram to get it.
# The bot only answers messages from this chat.
TELEGRAM_CHAT_ID=your_telegram_chat_id
